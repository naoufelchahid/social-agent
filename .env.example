# Optional primary extraction. Without this key, source-specific fallbacks are used.
FIRECRAWL_API_KEY=

# Optional: increases GitHub REST API limits for public repository extraction.
GITHUB_TOKEN=

# Required only for direct OAuth 2.0 publication after human acceptance.
# Never commit populated values.
X_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=

# Optional workspace-relative path overrides.
SOCIAL_AGENT_INPUT=content/urls.md
SOCIAL_AGENT_BRAND=content/brand.md
SOCIAL_AGENT_OUTPUT=output
